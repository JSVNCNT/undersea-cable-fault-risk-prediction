# Default: immutable local research snapshot. No accounts needed to preview.
VITE_DATA_MODE=bundled
# Optional live Python API. Blank means explicitly unavailable (no mock results).
VITE_API_URL=http://127.0.0.1:8000
# To use Supabase: set mode to supabase, URL and PUBLISHABLE key, then rebuild.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Never place a Supabase secret/service-role key or any private credential here.
